  "narrative": {
    "northStar": "Il tabellone delle partenze",
    "overview": "Un solo oggetto, visto una volta: il tabellone di una stazione. Il sito parte oggi e arriva tra tre giorni lavorativi, e la pagina lo dice con righe, celle e stati. Il tabellone è la carta d'identità del mondo, non il contenuto: il testo da leggere resta su campi chiari e comodi.",
    "keyCharacteristics": [
      "Lettere condensate maiuscole in celle fisse con linea di cerniera.",
      "Un solo colore di azione (giallo segnale) e un solo colore di stato (verde).",
      "Righe e filetti al posto di card.",
      "Movimento solo come flip a cascata, spento con movimento ridotto.",
      "Azioni su un piano fermo, mai dentro le celle."
    ],
    "rules": [
      {
        "name": "The One Action Rule",
        "body": "Il giallo segnale appartiene alle azioni e al prezzo.",
        "section": "colors"
      },
      {
        "name": "The Quiet Reading Rule",
        "body": "Il testo da leggere sta sempre fuori dalle celle, su campo piano a contrasto alto.",
        "section": "colors"
      },
      {
        "name": "The Cell Alphabet Rule",
        "body": "Le celle contengono solo maiuscole e cifre brevi.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Il tabellone non porta ombre esterne.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do tenere il giallo segnale per azioni e prezzo, e il verde solo per lo stato \"arrivato\".",
      "Do mettere il testo da leggere su campo piano, fuori dalle celle.",
      "Do mostrare le date vere dove il JavaScript è disponibile.",
      "Do etichettare ogni contenuto dimostrativo con \"Esempio dimostrativo\"."
    ],
    "donts": [
      "Don't usare le celle per frasi lunghe o per testo corrente.",
      "Don't aggiungere gradienti, aloni luminosi o effetti vetro.",
      "Don't trasformare l'elenco in una griglia di card uguali con icona, titolo e testo.",
      "Don't far muovere nulla senza prefers-reduced-motion e mai in avanzamento automatico."
    ]
  }
