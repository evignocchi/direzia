# Copia questo file in `.env` (sviluppo locale) e imposta le stesse variabili su Cloudflare Pages
# (Settings → Environment variables). Le variabili PUBLIC_* finiscono nel sito: non metterci segreti.

# ── Sito ────────────────────────────────────────────────────────────────────
# URL pubblico definitivo (canonical, sitemap, immagine OG). Obbligatorio per il lancio.
SITE_URL=https://www.tuodominio.it

# Link per prenotare la chiamata di 15 minuti (Cal.com o Calendly)
PUBLIC_BOOKING_URL=
# Link diretto per lasciare una recensione su Google (Google Business Profile → "Chiedi recensioni")
PUBLIC_GOOGLE_REVIEW_URL=
# Scheda Google Business Profile
PUBLIC_GOOGLE_BUSINESS_URL=

# ── Form di contatto (Cloudflare Pages Function: functions/api/contact.ts) ──
# Solo lato server: impostale come "Secret" su Cloudflare, mai nel repository.
# Opzione 1: invio email con Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Opzione 2: inoltro a un webhook (Zapier, Make, n8n, Slack…)
CONTACT_WEBHOOK_URL=

# Cloudflare Turnstile (anti-spam, facoltativo). Se vuote, resta attivo solo l'honeypot.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Lancio ──────────────────────────────────────────────────────────────────
# Consente di pubblicare con recensioni/progetti dimostrativi (solo per la fase di vendita iniziale)
ALLOW_DEMO=false
