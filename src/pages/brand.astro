---
/** Pagina interna per il team: logo, colori, font, regole. Non indicizzata. I valori arrivano da tokens.css. */
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import tokens from '../styles/tokens.css?raw';
import { ratio } from '../lib/contrast';
import { company } from '../data/company';

const colors = [...tokens.matchAll(/--color-([a-z-]+):\s*(#[0-9a-fA-F]{6})/g)].map(([, name, hex]) => ({ name, hex: hex.toUpperCase() }));
const onCrema = (hex: string) => ratio(hex, '#FBF7EE');
const textOn = (hex: string) => (ratio(hex, '#0F2F23') >= ratio(hex, '#FBF7EE') ? '#0F2F23' : '#FBF7EE');

const logos = [
  ['direzia-principale', 'Principale (verticale)', 'bg-crema'],
  ['direzia-orizzontale', 'Orizzontale', 'bg-crema'],
  ['direzia-simbolo', 'Solo simbolo', 'bg-crema'],
  ['direzia-monocromatico', 'Monocromatico', 'bg-crema'],
  ['direzia-negativo', 'Negativo su scuro', 'bg-abete'],
  ['favicon', 'Favicon', 'bg-sabbia'],
];
const assets = [
  ['og-1200x630.png', 'Immagine OG 1200×630'],
  ['avatar-800.png', 'Avatar social 800×800'],
  ['banner-linkedin-1584x396.png', 'Banner LinkedIn'],
  ['banner-facebook-1640x624.png', 'Banner Facebook'],
  ['onepager-header.png', 'Intestazione one-pager'],
];
---

<Base title={`Brand | ${company.brandName}`} noindex bare>
  <div class="wrap py-10 md:py-16">
    <a href="/" class="font-bold text-abete">← Torna al sito</a>
    <h1 class="mt-4 !text-3xl md:!text-4xl">Brand Direzia</h1>
    <p class="mt-3 max-w-2xl text-lg">Logo, colori e font per tutto quello che esce con il nostro nome. Pagina interna, non indicizzata.</p>

    <h2 class="mt-12 !text-2xl">Logo</h2>
    <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        logos.map(([file, label, bg]) => (
          <div class="rounded-[var(--radius-lg)] shadow-[inset_0_0_0_1px_var(--color-pietra)]">
            <div class={`flex h-44 items-center justify-center rounded-t-[var(--radius-lg)] p-6 ${bg}`}>
              <img src={`/brand/${file}.svg`} alt={label} class="max-h-28 w-auto max-w-full" />
            </div>
            <p class="flex items-center justify-between gap-2 p-4 text-sm">
              <strong>{label}</strong>
              <span>
                <a href={`/brand/${file}.svg`} download class="font-bold text-abete">SVG</a>
                {file !== 'favicon' && <> · <a href={`/brand/${file}.png`} download class="font-bold text-abete">PNG</a></>}
              </span>
            </p>
          </div>
        ))
      }
    </div>
    <p class="mt-4 max-w-2xl text-muschio">Area di rispetto: metà dell'altezza della D su ogni lato. Misure minime: simbolo 20 px, logo orizzontale 96 px di larghezza. Nessun effetto, ombra, rotazione o colore nuovo. Su fondi non verdi o scuri si usa la versione monocromatica.</p>
    <div class="mt-6 inline-block rounded-[var(--radius-md)] bg-abete p-5"><Logo variant="negative" class="h-9 w-auto" /></div>

    <h2 class="mt-14 !text-2xl">Colori</h2>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        colors.map((c) => (
          <li class="overflow-hidden rounded-[var(--radius-md)] shadow-[inset_0_0_0_1px_var(--color-pietra)]">
            <div class="flex h-20 items-end p-3 font-bold" style={`background:${c.hex};color:${textOn(c.hex)}`}>{c.name}</div>
            <p class="p-3 text-sm"><code>{c.hex}</code><br /><span class="text-muschio">Token <code>{c.name}</code> · {onCrema(c.hex).toFixed(1)}:1 su crema</span></p>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 max-w-2xl text-muschio">Lo zafferano si usa solo per i pulsanti principali. Tabella completa dei contrasti in <code>brand/BRAND.md</code>.</p>

    <h2 class="mt-14 !text-2xl">Font</h2>
    <div class="mt-5 grid gap-5 md:grid-cols-2">
      <div class="rounded-[var(--radius-lg)] bg-sabbia p-6">
        <p class="font-display text-4xl text-abete-scuro">Il tuo sito in 3 giorni.</p>
        <p class="mt-3 text-muschio"><strong>Young Serif</strong>, peso 400. Per titoli e cifre grandi.</p>
      </div>
      <div class="rounded-[var(--radius-lg)] bg-sabbia p-6">
        <p class="text-2xl font-bold text-abete-scuro">Prezzo massimo 500 € IVA inclusa.</p>
        <p class="mt-2">Testo corrente in regolare, pulsanti ed etichette in grassetto. 0123456789 àèéìòù</p>
        <p class="mt-3 text-muschio"><strong>Atkinson Hyperlegible Next</strong>, pesi 400 e 700. Per testo e interfaccia.</p>
      </div>
    </div>

    <h2 class="mt-14 !text-2xl">Tono di voce</h2>
    <ol class="mt-5 max-w-2xl list-decimal space-y-2 pl-6 marker:font-bold marker:text-abete">
      <li>Frasi corte, una idea alla volta.</li>
      <li>Parla alla persona e dai del tu.</li>
      <li>Prima il vantaggio, poi come funziona.</li>
      <li>Cifre vere, mai aggettivi vaghi.</li>
      <li>Parola tecnica: spiegala in una riga o toglila.</li>
    </ol>

    <h2 class="mt-14 !text-2xl">Asset pronti</h2>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2">
      {assets.map(([f, l]) => <li><a href={`/brand/${f}`} download class="flex items-center justify-between rounded-[var(--radius-md)] px-4 py-3 font-bold text-abete no-underline shadow-[inset_0_0_0_1px_var(--color-pietra)] hover:bg-abete-chiaro">{l}<span class="text-sm text-muschio">{f.split('.').pop()?.toUpperCase()}</span></a></li>)}
    </ul>
    <p class="mt-4 text-muschio">La firma email in HTML e il testo dell'email per chiedere recensioni sono in <code>brand/assets/</code> nel repository.</p>
  </div>
</Base>
