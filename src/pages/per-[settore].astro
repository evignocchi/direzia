---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import DemoSite from '../components/DemoSite.astro';
import DemoBadge from '../components/DemoBadge.astro';
import ContactSection from '../components/ContactSection.astro';
import Commitments from '../components/home/Commitments.astro';
import { sectors } from '../data/sectors';
import { getProject } from '../data/projects';
import { sectorPage } from '../data/copy';
import { company, whatsappHref } from '../data/company';
import { graph, organizationSchema, serviceSchema, siteUrl } from '../lib/schema';

export function getStaticPaths() {
  return sectors.map((sector) => ({ params: { settore: sector.slug }, props: { sector } }));
}
const { sector } = Astro.props;
const project = getProject(sector.exampleProject);
const base = siteUrl(Astro.site);
const schema = graph(organizationSchema(base), serviceSchema(base));
---

<Base title={`${sector.metaTitle} | ${company.brandName}`} description={sector.metaDescription} schema={schema} whatsappMessage={sector.whatsapp}>
  <section class="bg-crema">
    <div class="wrap grid items-center gap-10 py-12 md:grid-cols-[1.05fr_0.95fr] md:py-20">
      <div>
        <h1>{sector.headline}</h1>
        <p class="mt-5 max-w-xl text-lg md:text-xl">{sector.intro}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#contatti" class="btn btn-primary" data-cta="request-sector">{sectorPage.cta}<Icon name="arrow" size={20} /></a>
          <a href={whatsappHref(sector.whatsapp)} class="btn btn-secondary" rel="noopener" data-cta="whatsapp-sector"><Icon name="whatsapp" size={20} />Scrivici su WhatsApp</a>
        </div>
      </div>
      {
        project && (
          <div>
            <DemoSite frame="browser" site={project.site} name={project.name} label={`Esempio di sito per ${sector.forWho}`} />
            <p class="mt-3 flex items-center gap-2 text-sm text-muschio">{sectorPage.exampleHeading}<DemoBadge /></p>
          </div>
        )
      }
    </div>
  </section>

  <Commitments />

  <section class="section bg-sabbia" aria-labelledby="problemi">
    <div class="wrap">
      <h2 id="problemi" class="max-w-2xl">{sectorPage.problemsHeading}</h2>
      <ol class="mt-8 grid gap-8 md:grid-cols-3">
        {sector.problems.map((p) => (
          <li class="border-t-2 border-abete pt-4">
            <h3 class="text-abete-scuro">{p.title}</h3>
            <p class="mt-2">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bg-crema" aria-labelledby="cosa-mettiamo">
    <div class="wrap grid gap-10 md:grid-cols-2 md:gap-16">
      <div>
        <h2 id="cosa-mettiamo">{sectorPage.featuresHeading}</h2>
        <ul class="mt-6 space-y-3">
          {sector.features.map((f) => <li class="flex gap-3"><Icon name="check" size={22} class="mt-0.5 shrink-0 text-abete" />{f}</li>)}
        </ul>
      </div>
      <div class="self-start rounded-[var(--radius-lg)] bg-abete-chiaro p-6 md:p-8">
        <h2 class="!text-2xl">{sectorPage.needsHeading}</h2>
        <ul class="mt-4 space-y-3">
          {sector.needs.map((n) => <li class="flex gap-3"><Icon name="check" size={22} class="mt-0.5 shrink-0 text-abete" />{n}</li>)}
        </ul>
        <a href="/#come-funziona" class="mt-5 inline-flex items-center gap-2 font-bold text-abete">Come funziona, giorno per giorno<Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="bg-sabbia py-10" aria-label="Altri settori">
    <div class="wrap">
      <p class="font-bold text-abete-scuro">{sectorPage.otherSectors}</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {sectors.filter((s) => s.slug !== sector.slug).map((s) => <li><a href={`/per-${s.slug}`} class="inline-flex min-h-11 items-center rounded-full px-4 font-bold text-abete shadow-[inset_0_0_0_2px_var(--color-pietra)] no-underline hover:bg-abete-chiaro">{s.name}</a></li>)}
      </ul>
    </div>
  </section>

  <ContactSection sector={sector.slug} whatsappMessage={sector.whatsapp} />
</Base>
