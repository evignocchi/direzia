---
/**
 * Foto del team. Se esiste src/assets/team/<nome-file>.jpg|png|webp, viene ottimizzata (AVIF + WebP, srcset, lazy).
 * Altrimenti compare un segnaposto chiaramente marcato. Istruzioni: src/assets/team/LEGGIMI.md
 */
import { Picture } from 'astro:assets';
import { copy } from '../data/copy';

interface Props {
  /** Nome del file senza estensione, es. "fondatore-1" */
  file: string;
  name: string;
  role: string;
  class?: string;
}
const { file, name, role, class: className = '' } = Astro.props;
const photos = import.meta.glob<{ default: import('astro').ImageMetadata }>('../assets/team/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const match = Object.entries(photos).find(([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === file);
---

<figure class:list={['m-0', className]} data-team-photo={match ? 'real' : 'placeholder'}>
  {
    match ? (
      <Picture
        src={match[1].default}
        alt={`${name}, ${role}`}
        formats={['avif', 'webp']}
        widths={[240, 360, 480]}
        sizes="(min-width: 768px) 240px, 45vw"
        loading="lazy"
        class="shape-d aspect-[4/5] w-full object-cover"
      />
    ) : (
      <div class="shape-d relative flex aspect-[4/5] w-full flex-col items-center justify-end overflow-hidden bg-abete-chiaro" data-placeholder>
        <svg viewBox="0 0 120 150" class="w-3/5 text-abete/35" aria-hidden="true" fill="currentColor">
          <circle cx="60" cy="52" r="26" />
          <path d="M8 150c0-30 24-52 52-52s52 22 52 52z" />
        </svg>
        <span class="badge-demo absolute left-3 top-3">{copy.about.photoPending}</span>
      </div>
    )
  }
  <figcaption class="mt-3">
    <strong class="block text-abete-scuro">{name}</strong>
    <span class="text-muschio">{role}</span>
  </figcaption>
</figure>
