---
import Base from '../layouts/Base.astro';
import { company } from '../data/company';
import type { LegalSection } from '../data/legal';

interface Props {
  title: string;
  intro: string;
  sections: LegalSection[];
  description?: string;
  /** Avviso in cima alla pagina (es. testo da validare) */
  notice?: string;
}
const { title, intro, sections, description = intro, notice } = Astro.props;
---

<Base title={`${title} | ${company.brandName}`} description={description.slice(0, 160)}>
  <div class="wrap max-w-3xl py-12 md:py-20">
    <h1 class="!text-3xl md:!text-4xl">{title}</h1>
    <p class="mt-4 text-lg">{intro}</p>
    {notice && <p class="mt-6 rounded-[var(--radius-md)] bg-attenzione-chiaro p-4 font-bold text-attenzione" data-legal-notice>{notice}</p>}
    <div class="mt-10 space-y-9">
      {
        sections.map((s, i) => (
          <section>
            <h2 class="!text-2xl">{i + 1}. {s.title}</h2>
            {s.paragraphs?.map((p) => <p class="mt-3">{p}</p>)}
            {s.list && <ul class="mt-3 list-disc space-y-2 pl-6 marker:text-abete">{s.list.map((li) => <li>{li}</li>)}</ul>}
          </section>
        ))
      }
    </div>
    <p class="mt-12"><a href="/" class="font-bold text-abete">Torna alla home</a></p>
  </div>
</Base>
