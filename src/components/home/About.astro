---
import Icon from '../Icon.astro';
import TeamPhoto from '../TeamPhoto.astro';
import { copy } from '../../data/copy';
import { company, fullAddress } from '../../data/company';
const c = copy.about;
---

<section id="chi-siamo" class="section bg-sabbia" aria-labelledby="chi-titolo">
  <div class="wrap grid gap-12 md:grid-cols-[1.1fr_0.9fr] md:gap-16">
    <div>
      <h2 id="chi-titolo" class="reveal">{c.heading}</h2>
      <p class="reveal mt-4 max-w-xl text-lg">{c.intro}</p>

      <ul class="mt-8 space-y-5">
        {
          c.reasons.map((r) => (
            <li class="reveal flex gap-3">
              <Icon name="check" size={22} class="mt-0.5 shrink-0 text-abete" />
              <div>
                <p class="font-bold text-abete-scuro">{r.title}</p>
                <p class="text-muschio">{r.text}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="reveal mt-9 rounded-[var(--radius-lg)] bg-crema p-6">
        <h3 class="text-abete-scuro">{c.visit}</h3>
        <ul class="mt-3 space-y-2">
          <li class="flex gap-2"><Icon name="pin" size={20} class="mt-1 shrink-0 text-abete" />{fullAddress()}</li>
          <li class="flex gap-2"><Icon name="clock" size={20} class="mt-1 shrink-0 text-abete" />{company.openingHours}</li>
        </ul>
      </div>
    </div>

    <div class="grid grid-cols-2 items-start gap-5">
      {company.founders.map((f, i) => <TeamPhoto file={f.photo.split('/').pop()!.replace(/\.[^.]+$/, '')} name={f.name} role={f.role} class={i % 2 ? 'mt-10' : ''} />)}
    </div>
  </div>
</section>
