---
import Icon from '../Icon.astro';
import { copy } from '../../data/copy';
import { offer } from '../../data/offer';
const c = copy.how;
---

<section id="come-funziona" class="section bg-abete-chiaro" aria-labelledby="come-titolo">
  <div class="wrap">
    <div class="reveal max-w-2xl">
      <h2 id="come-titolo">{c.heading}</h2>
      <p class="mt-4 text-lg">{c.intro}</p>
    </div>

    <ol class="relative mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
      {
        offer.timeline.map((step) => (
          <li class="reveal relative flex gap-5 md:block">
            <div class="flex shrink-0 flex-col items-center md:mb-5 md:flex-row md:items-center md:gap-4">
              <span class="shape-d inline-flex h-16 w-[4.5rem] items-center justify-center bg-abete font-display text-3xl text-crema" aria-hidden="true">
                {step.day}
              </span>
              <span class="mt-2 hidden h-full w-0.5 grow bg-abete/30 md:mt-0 md:block md:h-0.5 md:w-full md:grow" aria-hidden="true" />
            </div>
            <div>
              <p class="text-sm font-bold uppercase tracking-wide text-abete">{c.dayLabel} {step.day}</p>
              <h3 class="mt-1 text-abete-scuro">{step.title}</h3>
              <p class="mt-3">{step.text}</p>
              <p class="mt-4 flex gap-2 rounded-[var(--radius-md)] bg-crema px-4 py-3 font-bold text-abete-scuro">
                <Icon name="check" size={20} class="mt-0.5 shrink-0 text-abete" />
                {step.you}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-14 grid gap-6 rounded-[var(--radius-lg)] bg-crema p-6 md:grid-cols-[0.8fr_1.2fr] md:gap-10 md:p-9">
      <div>
        <h3 class="text-abete-scuro">{c.needsHeading}</h3>
        <p class="mt-2 text-muschio">{c.needsIntro}</p>
      </div>
      <ul class="space-y-3">
        {
          offer.customerNeeds.map((n) => (
            <li class="flex gap-3">
              <Icon name="check" size={22} class="mt-0.5 shrink-0 text-abete" />
              {n.text}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
