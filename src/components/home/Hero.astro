---
import Flap from '../Flap.astro';
import Icon from '../Icon.astro';
import { copy } from '../../data/copy';
import { offer } from '../../data/offer';
import { whatsappHref } from '../../data/company';

const h = copy.home;
const b = h.board;
const statusClass = ['text-signal', 'text-white', 'text-go'];
let idx = 0;
const lineStart = h.titleLines.map((l) => {
  const s = idx;
  idx += [...l].filter((c) => c !== ' ').length;
  return s;
});
---

<section class="on-dark bg-ink text-white" aria-labelledby="hero-title">
  <div class="wrap pt-7 md:pt-9">
    <p id="saluto" hidden class="mb-5 inline-block rounded bg-cell px-4 py-2 text-lg font-semibold text-signal" data-template={copy.hero.greeting}></p>
    <script is:inline>
      (function () {
        try {
          var el = document.getElementById('saluto');
          var raw = new URLSearchParams(location.search).get('r');
          if (!el || !raw) return;
          // Solo lettere, spazi, apostrofi e trattini; massimo 30 caratteri. Il nome non viene salvato.
          var name = raw.replace(/[^\p{L}' -]/gu, '').trim().slice(0, 30);
          if (!name) return;
          name = name.charAt(0).toUpperCase() + name.slice(1);
          el.textContent = el.getAttribute('data-template').replace('{nome}', name);
          el.hidden = false;
        } catch (e) {}
      })();
    </script>

    <h1 id="hero-title" class="!text-white" style="font-size: clamp(2.35rem, 11.4vw, 5.6rem)">
      <span class="sr-only-x">{offer.name}</span>
      <span class="flex flex-col gap-[0.09em]" aria-hidden="true">
        {h.titleLines.map((line, i) => <Flap text={line} start={lineStart[i]} />)}
      </span>
    </h1>

    <p class="mt-4 max-w-4xl text-[1.3rem] leading-snug text-white md:text-[1.45rem]">{copy.hero.sub}</p>

    <ol class="mt-6 overflow-hidden rounded-t-lg border border-b-0 border-line bg-board md:mt-6" aria-label={b.caption}>
      {
        offer.timeline.map((step, i) => (
          <li class="grid grid-cols-[auto_1fr] items-center gap-x-4 gap-y-1 border-b border-line px-4 py-4 md:grid-cols-[auto_minmax(0,1.1fr)_minmax(0,1fr)_auto] md:gap-x-6 md:px-6 md:py-2.5">
            <span class="flap text-[2.7rem] md:text-[3rem]" aria-hidden="true"><span class="flap-cell flap-white" style={`--i:${i * 4}`}>{step.day}</span></span>
            <p class="font-display text-[1.65rem] uppercase leading-none text-white md:text-[2.1rem]">
              <span class="sr-only-x">Giorno {step.day}: </span>{step.board}
            </p>
            <p class="col-start-2 text-mist md:col-start-3">{step.you}</p>
            <p class={`col-start-2 flex items-center gap-2 font-display text-xl uppercase leading-none md:col-start-4 md:text-2xl ${statusClass[i]}`}>
              <span class="inline-block h-2.5 w-2.5 rounded-full bg-current" aria-hidden="true" />
              {step.status}
              <span class="font-body text-base font-normal normal-case text-mist" data-day-offset={i}>
                {i === 2 ? b.arriveFallback : ''}
              </span>
            </p>
          </li>
        ))
      }
      <li class="grid grid-cols-3 divide-x divide-line bg-ink">
        {
          b.facts.map((f) => (
            <div class="px-3 py-4 md:px-6 md:py-3">
              <p class="text-xs font-semibold uppercase tracking-wider text-mist md:text-sm">{f.label}</p>
              <p class="font-display text-[1.55rem] uppercase leading-none text-signal md:text-[2.1rem]">{f.value}</p>
              <p class="mt-1 text-sm text-mist md:text-base">{f.note}</p>
            </div>
          ))
        }
      </li>
    </ol>
    <script is:inline>
      // Date vere: "se parti oggi" (giorni lavorativi). Solo testo: senza JavaScript resta "Giorno 3".
      (function () {
        try {
          var days = ['dom', 'lun', 'mar', 'mer', 'gio', 'ven', 'sab'];
          var mon = ['gen', 'feb', 'mar', 'apr', 'mag', 'giu', 'lug', 'ago', 'set', 'ott', 'nov', 'dic'];
          var weekend = function (d) { return d.getDay() === 0 || d.getDay() === 6; };
          var today = new Date();
          var start = new Date(today);
          while (weekend(start)) start.setDate(start.getDate() + 1);
          document.querySelectorAll('[data-day-offset]').forEach(function (el) {
            var n = +el.getAttribute('data-day-offset');
            var x = new Date(start);
            while (n > 0) { x.setDate(x.getDate() + 1); if (!weekend(x)) n--; }
            var same = x.toDateString() === today.toDateString();
            el.textContent = same ? 'oggi' : days[x.getDay()] + ' ' + x.getDate() + ' ' + mon[x.getMonth()];
          });
        } catch (e) {}
      })();
    </script>
  </div>

  <div class="bg-signal text-ink">
    <div class="wrap flex flex-col gap-4 py-5 lg:flex-row lg:items-center lg:justify-between">
      <p class="font-display text-[1.9rem] uppercase leading-none md:text-[2.4rem] lg:whitespace-nowrap">{b.action.label}: <span class="underline decoration-[0.08em] underline-offset-[0.12em]">{b.action.value}</span></p>
      <div class="flex flex-col gap-3 sm:flex-row lg:shrink-0">
        <a href="#contatti" class="btn btn-ink whitespace-nowrap" data-cta="request-hero">
          {copy.cta.primary}
          <Icon name="arrow" size={22} />
        </a>
        <a href={whatsappHref(copy.cta.whatsappMessage)} class="btn btn-ink-outline whitespace-nowrap" rel="noopener" data-cta="whatsapp-hero">
          <Icon name="whatsapp" size={22} />
          WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
