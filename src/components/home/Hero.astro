---
import Icon from '../Icon.astro';
import DemoSite from '../DemoSite.astro';
import DemoBadge from '../DemoBadge.astro';
import { copy } from '../../data/copy';
import { company, phoneHref, whatsappHref } from '../../data/company';
import { getProject } from '../../data/projects';

const phoneDemo = getProject('osteria-del-fico-storto')!;
const browserDemo = getProject('studio-alderighi-commercialisti')!;
---

<section class="relative overflow-hidden bg-crema" aria-labelledby="hero-title">
  <div class="wrap grid items-center gap-10 pb-0 pt-10 md:pb-20 md:pt-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
    <div class="pb-2 md:pb-0">
      <p id="saluto" hidden class="mb-4 inline-block rounded-full bg-abete-chiaro px-4 py-1.5 text-lg font-bold text-abete" data-template={copy.hero.greeting}></p>
      <script is:inline>
        (function () {
          try {
            var el = document.getElementById('saluto');
            var raw = new URLSearchParams(location.search).get('r');
            if (!el || !raw) return;
            // Solo lettere, spazi, apostrofi e trattini; massimo 30 caratteri. Il nome non viene salvato.
            var name = raw.replace(/[^\p{L}' -]/gu, '').trim().slice(0, 30);
            if (!name) return;
            name = name.charAt(0).toUpperCase() + name.slice(1);
            el.textContent = el.getAttribute('data-template').replace('{nome}', name);
            el.hidden = false;
          } catch (e) {}
        })();
      </script>

      <h1 id="hero-title">{copy.hero.headline}</h1>
      <p class="mt-5 max-w-xl text-lg text-inchiostro md:text-xl">{copy.hero.sub}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#contatti" class="btn btn-primary" data-cta="request-hero">
          {copy.cta.primary}
          <Icon name="arrow" size={20} />
        </a>
        <a href={whatsappHref(copy.cta.whatsappMessage)} class="btn btn-secondary" rel="noopener" data-cta="whatsapp-hero">
          <Icon name="whatsapp" size={20} />
          {copy.cta.whatsapp}
        </a>
      </div>
      <p class="mt-4 text-muschio">
        Preferisci parlare? <a href={phoneHref} class="font-bold text-abete" data-cta="phone-hero"><span class="tabular">{company.phone.display}</span></a>
      </p>

      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-base font-bold text-abete-scuro">
        {
          copy.hero.proof.map((p) => (
            <li class="flex items-center gap-2">
              <Icon name="check" size={20} class="text-abete" />
              {p}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative">
      <div class="pattern-frecce relative h-[26rem] overflow-hidden rounded-[var(--radius-lg)] bg-abete md:h-[33rem] md:rounded-[0.9rem_999px_999px_0.9rem]">
        <DemoSite
          frame="browser"
          site={browserDemo.site}
          name={browserDemo.name}
          label={`Esempio di sito per uno studio professionale, visto da computer`}
          class="absolute left-[7%] top-[9%] hidden w-[68%] md:block"
        />
        <DemoSite
          frame="phone"
          site={phoneDemo.site}
          name={phoneDemo.name}
          label={`Esempio di sito per un ristorante, visto da telefono`}
          class="absolute left-1/2 top-8 w-[13.5rem] -translate-x-1/2 md:left-auto md:right-[11%] md:top-[22%] md:w-[14.5rem] md:translate-x-0"
        />
      </div>
      <p class="mt-3 flex items-center justify-center gap-2 text-sm text-muschio md:justify-end md:pr-4">
        {copy.hero.deviceCaption}
        <DemoBadge />
      </p>
    </div>
  </div>
</section>
