---
import { copy } from '../../data/copy';
const p = copy.problem;
---

<section class="section bg-sabbia" aria-labelledby="problema-titolo">
  <div class="wrap grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:gap-16">
    <div class="reveal">
      <h2 id="problema-titolo">{p.heading}</h2>
      <p class="mt-4 text-lg text-muschio">{p.intro}</p>
    </div>
    <div>
      <ol class="divide-y divide-pietra border-y border-pietra">
        {
          p.items.map((item) => (
            <li class="reveal py-6 md:py-7">
              <h3 class="text-abete-scuro">{item.title}</h3>
              <p class="mt-2 max-w-xl text-inchiostro">{item.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="reveal mt-8 max-w-xl text-xl font-bold text-abete">{p.closing}</p>
    </div>
  </div>
</section>
