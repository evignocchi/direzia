---
import ProjectCard from '../ProjectCard.astro';
import { copy } from '../../data/copy';
import { projects } from '../../data/projects';
const c = copy.home.projects;
const featured = projects.slice(0, 4);
const others = projects.slice(4);
const hasDemo = projects.some((p) => p.demo);
---

<section id="progetti" class="section bg-paper" aria-labelledby="progetti-titolo">
  <div class="wrap">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <h2 id="progetti-titolo">{c.heading}</h2>
      <p class="max-w-md text-lg text-graphite">{c.intro}</p>
    </div>

    <!-- Su telefono: striscia da scorrere con il dito (nessun avanzamento automatico) -->
    <div
      class="-mx-5 mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-4 md:mx-0 md:grid md:grid-cols-2 md:gap-x-5 md:gap-y-10 md:overflow-visible md:px-0 md:pb-0 lg:grid-cols-4"
      tabindex="0"
      role="group"
      aria-label="Progetti in evidenza"
    >
      {featured.map((p) => <ProjectCard project={p} class="w-[78vw] max-w-sm shrink-0 snap-start md:w-auto md:max-w-none" />)}
    </div>

    <details class="group/more mt-8">
      <summary class="btn btn-secondary w-fit cursor-pointer group-open/more:hidden">{c.more}</summary>
      <div class="grid gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {others.map((p) => <ProjectCard project={p} />)}
      </div>
    </details>

    {hasDemo && <p class="mt-10 max-w-2xl text-graphite" data-demo-note>{c.demoNote}</p>}
  </div>
</section>
