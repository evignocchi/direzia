---
import Icon from '../Icon.astro';
import { copy } from '../../data/copy';
import { faq } from '../../data/faq';
const c = copy.faq;
---

<section id="domande" class="section bg-white" aria-labelledby="domande-titolo">
  <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div>
      <h2 id="domande-titolo">{c.heading}</h2>
      <p class="mt-4 text-lg text-graphite">{c.intro}</p>
    </div>
    <div class="border-t border-ink">
      {
        faq.map((f) => (
          <details class="group border-b border-rule">
            <summary class="flex min-h-14 cursor-pointer items-center justify-between gap-4 py-4 text-xl font-semibold">
              {f.q}
              <Icon name="chevron" size={24} class="shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" />
            </summary>
            <p class="max-w-prose pb-5 pr-8 text-lg text-graphite">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
