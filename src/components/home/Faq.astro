---
import Icon from '../Icon.astro';
import { copy } from '../../data/copy';
import { faq } from '../../data/faq';
const c = copy.faq;
---

<section id="domande" class="section bg-crema" aria-labelledby="domande-titolo">
  <div class="wrap grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:gap-16">
    <div class="reveal">
      <h2 id="domande-titolo">{c.heading}</h2>
      <p class="mt-4 text-lg text-muschio">{c.intro}</p>
    </div>
    <div class="divide-y divide-pietra border-y border-pietra">
      {
        faq.map((f) => (
          <details class="group py-1">
            <summary class="flex cursor-pointer items-center justify-between gap-4 rounded py-4 text-lg font-bold text-abete-scuro">
              {f.q}
              <Icon name="chevron" size={22} class="shrink-0 text-abete transition-transform group-open:rotate-180 motion-reduce:transition-none" />
            </summary>
            <p class="max-w-prose pb-5 pr-8">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
