---
import Icon from '../Icon.astro';
import { copy } from '../../data/copy';
import { offer } from '../../data/offer';
const c = copy.guarantee;
---

<section id="garanzia" class="on-dark pattern-frecce bg-abete text-crema section" aria-labelledby="garanzia-titolo">
  <div class="wrap grid items-start gap-10 md:grid-cols-[0.55fr_1.45fr] md:gap-16">
    <div class="reveal">
      <div class="shape-d flex aspect-[5/4] w-full max-w-xs flex-col items-center justify-center bg-zafferano px-6 text-center text-abete-scuro">
        <Icon name="shield" size={44} />
        <p class="mt-2 font-display text-5xl leading-none">{offer.guarantee.days}</p>
        <p class="mt-1 text-lg font-bold">giorni per cambiare idea</p>
      </div>
    </div>

    <div>
      <h2 id="garanzia-titolo" class="!text-crema reveal">{c.heading}</h2>
      <p class="mt-3 text-lg text-abete-chiaro">{c.intro}</p>
      <dl class="mt-8 divide-y divide-crema/20 border-y border-crema/20">
        {
          c.points.map((p) => (
            <div class="reveal grid gap-1 py-4 md:grid-cols-[14rem_1fr] md:gap-6">
              <dt class="font-bold text-crema">{p.title}</dt>
              <dd class="text-abete-chiaro">{p.text}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-6 text-abete-chiaro">{c.after}</p>
      <a href="/termini-garanzia" class="mt-4 inline-flex items-center gap-2 font-bold text-zafferano">{c.link}<Icon name="arrow" size={18} /></a>
    </div>
  </div>
</section>
