---
import Icon from '../Icon.astro';
import { copy } from '../../data/copy';
import { offer } from '../../data/offer';
const c = copy.home.included;
---

<section id="incluso" class="section bg-white" aria-labelledby="incluso-titolo">
  <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div>
      <h2 id="incluso-titolo">{c.heading}</h2>
      <p class="mt-4 text-lg text-graphite">{c.intro}</p>
      <details class="mt-6">
        <summary class="inline-flex min-h-11 cursor-pointer items-center gap-2 font-semibold underline decoration-2 underline-offset-4">{c.scopeToggle}</summary>
        <ul class="mt-3 space-y-2 text-graphite">
          {offer.outOfScope.map((o) => <li class="flex gap-3"><Icon name="close" size={20} class="mt-1 shrink-0" />{o}</li>)}
        </ul>
        <p class="mt-3 text-graphite">{copy.included.outOfScopeIntro}</p>
      </details>
    </div>
    <ul class="grid gap-x-10 border-t border-ink sm:grid-cols-2">
      {
        offer.included.map((i) => (
          <li class="flex items-start gap-3 border-b border-rule py-3.5 text-lg font-semibold">
            <Icon name="check" size={24} class="mt-0.5 shrink-0 text-go-ink" />
            {i.title}
          </li>
        ))
      }
    </ul>
  </div>
</section>
