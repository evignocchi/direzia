---
import Icon from '../Icon.astro';
import DemoBadge from '../DemoBadge.astro';
import { copy } from '../../data/copy';
import { testimonials } from '../../data/testimonials';
const c = copy.reviews;
const h = copy.home.reviews;
const first = testimonials.slice(0, 3);
const rest = testimonials.slice(3);
const hasDemo = testimonials.some((t) => t.demo);
---

<section id="recensioni" class="section bg-paper" aria-labelledby="recensioni-titolo">
  <div class="wrap">
    <h2 id="recensioni-titolo">{h.heading}</h2>

    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {
        first.map((t) => (
          <figure class="flex flex-col rounded-lg bg-white p-6 shadow-[var(--shadow-soft)]" data-review>
            <div class="flex items-center justify-between gap-3">
              <p class="flex text-ink" role="img" aria-label={c.stars(t.stars)}>
                {[1, 2, 3, 4, 5].map((n) => <Icon name="star" size={20} class={n <= t.stars ? '' : 'text-rule'} />)}
              </p>
              {t.demo && <DemoBadge />}
            </div>
            <blockquote class="mt-4 flex-1 text-lg">{t.text}</blockquote>
            <figcaption class="mt-5 text-sm"><strong>{t.author}</strong>, {t.role}<br /><span class="text-graphite">{t.business}</span></figcaption>
          </figure>
        ))
      }
    </div>

    <details class="group/more mt-6">
      <summary class="btn btn-secondary w-fit cursor-pointer group-open/more:hidden">{h.more} ({rest.length})</summary>
      <div class="grid gap-5 md:grid-cols-3">
        {
          rest.map((t) => (
            <figure class="flex flex-col rounded-lg bg-white p-6 shadow-[var(--shadow-soft)]" data-review>
              <div class="flex items-center justify-between gap-3">
                <p class="flex text-ink" role="img" aria-label={c.stars(t.stars)}>
                  {[1, 2, 3, 4, 5].map((n) => <Icon name="star" size={20} class={n <= t.stars ? '' : 'text-rule'} />)}
                </p>
                {t.demo && <DemoBadge />}
              </div>
              <blockquote class="mt-4 flex-1 text-lg">{t.text}</blockquote>
              <figcaption class="mt-5 text-sm"><strong>{t.author}</strong>, {t.role}<br /><span class="text-graphite">{t.business}</span></figcaption>
            </figure>
          ))
        }
      </div>
    </details>

    <div class="mt-8 flex flex-col gap-3 text-graphite sm:flex-row sm:items-center sm:justify-between">
      {hasDemo && <p class="max-w-2xl" data-demo-note>{c.demoNote}</p>}
      <a href="/lascia-una-recensione" class="font-semibold text-ink">{c.leaveReview}</a>
    </div>
  </div>
</section>
