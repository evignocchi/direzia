---
import Icon from './Icon.astro';
import { copy } from '../data/copy';
import { phoneHref, whatsappHref } from '../data/company';

interface Props {
  whatsappMessage?: string;
}
const { whatsappMessage = copy.cta.whatsappMessage } = Astro.props;
---

<nav
  aria-label="Contattaci subito"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-pietra bg-crema px-3 pt-2.5 shadow-[0_-8px_24px_-12px_rgb(15_47_35/0.3)] md:hidden print:hidden"
  style="padding-bottom: max(0.625rem, env(safe-area-inset-bottom))"
>
  <ul class="grid grid-cols-[1fr_1fr_1.35fr] gap-2">
    <li>
      <a href={phoneHref} class="btn btn-secondary !min-h-12 w-full !px-2 !text-base" data-cta="phone-bar">
        <Icon name="phone" size={20} />
        {copy.cta.call}
      </a>
    </li>
    <li>
      <a href={whatsappHref(whatsappMessage)} class="btn btn-secondary !min-h-12 w-full !px-2 !text-base" data-cta="whatsapp-bar" rel="noopener">
        <Icon name="whatsapp" size={20} />
        WhatsApp
      </a>
    </li>
    <li>
      <a href="/#contatti" class="btn btn-primary !min-h-12 w-full !px-2 !text-base" data-cta="request-bar">{copy.cta.mobileRequest}</a>
    </li>
  </ul>
</nav>
