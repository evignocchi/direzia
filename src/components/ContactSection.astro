---
import Icon from './Icon.astro';
import ContactForm from './ContactForm.astro';
import { copy } from '../data/copy';
import TeamPhoto from './TeamPhoto.astro';
import { company, fullAddress, phoneHref, whatsappHref } from '../data/company';

interface Props {
  sector?: string;
  whatsappMessage?: string;
}
const { sector = '', whatsappMessage = copy.cta.whatsappMessage } = Astro.props;
const c = copy.contact;
const h = copy.home.contact;
const hasBooking = !!company.bookingUrl;
---

<section id="contatti" class="on-dark section bg-board text-white" aria-labelledby="contatti-titolo">
  <div class="wrap grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div class="reveal">
      <h2 id="contatti-titolo" class="!text-white">{h.heading}</h2>
      <p class="mt-4 max-w-lg text-xl text-white">{h.text}</p>

      <p class="mt-8 font-semibold text-mist">{c.alternativesHeading}</p>
      <div class="mt-3 flex flex-col gap-3 sm:max-w-sm">
        <a href={whatsappHref(whatsappMessage)} class="btn btn-secondary-dark" rel="noopener" data-cta="whatsapp-contact">
          <Icon name="whatsapp" size={20} />
          {copy.cta.whatsapp}
        </a>
        <a href={phoneHref} class="btn btn-secondary-dark" data-cta="phone-contact">
          <Icon name="phone" size={20} />
          <span>{copy.cta.callLong} <span class="tabular">{company.phone.display}</span></span>
        </a>
        {
          hasBooking && (
            <a href={company.bookingUrl} class="btn btn-secondary-dark" rel="noopener" data-cta="book-contact">
              <Icon name="clock" size={20} />
              {copy.cta.book}
            </a>
          )
        }
      </div>
      <div class="mt-10 border-t border-line pt-8">
        <p class="font-display text-2xl uppercase leading-none">{copy.about.heading}</p>
        <div class="mt-5 flex items-start gap-5">
          {company.founders.map((f) => <TeamPhoto file={f.photo.split('/').pop()!.replace(/\.[^.]+$/, '')} name={f.name} role={f.role} class="w-28 text-sm [&_strong]:text-white [&_figcaption_span]:text-mist" />)}
        </div>
        <ul class="mt-5 space-y-1.5 text-mist">
          <li class="flex gap-2"><Icon name="pin" size={20} class="mt-0.5 shrink-0" />{fullAddress()}</li>
          <li class="flex gap-2"><Icon name="clock" size={20} class="mt-0.5 shrink-0" />{company.openingHours}</li>
        </ul>
      </div>
    </div>

    <div class="on-light reveal rounded-lg bg-white p-6 text-ink shadow-[var(--shadow-lift)] md:p-8">
      <h3 class="text-2xl uppercase">{c.heading}</h3>
      <p class="mb-6 mt-2 text-graphite">{c.intro}</p>
      <ContactForm sector={sector} />
    </div>
  </div>
</section>
