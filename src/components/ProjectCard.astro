---
import DemoSite from './DemoSite.astro';
import DemoBadge from './DemoBadge.astro';
import { copy } from '../data/copy';
import { projectCategoryLabel, type Project } from '../data/projects';

interface Props {
  project: Project;
  class?: string;
}
const { project: p, class: className = '' } = Astro.props;
---

<article class:list={['group relative', className]} data-project-card>
  <div class="relative">
    <DemoSite frame="browser" site={p.site} name={p.name} label={`Anteprima del sito di ${p.name}`} class="transition-transform duration-300 group-hover:-translate-y-1 motion-reduce:transition-none motion-reduce:group-hover:translate-y-0" />
    {p.demo && <DemoBadge class="absolute right-2 top-1.5" />}
  </div>
  <div class="mt-4 flex items-start justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-graphite">{projectCategoryLabel(p.category)}</p>
      <h3 class="mt-0.5 text-[1.55rem] uppercase leading-none">
        <a href={`/progetti/${p.slug}`} class="no-underline after:absolute after:inset-0 after:content-[''] group-hover:underline">{p.name}</a>
      </h3>
      <p class="mt-2 text-graphite">{p.result}</p>
    </div>
    <p class="flex shrink-0 flex-col items-center gap-1 text-xs font-semibold uppercase text-graphite">
      <span class="sr-only-x">Online in {copy.showcase.daysLabel(p.deliveryDays)}</span>
      <span class="flap flap-static text-[2.1rem]" aria-hidden="true"><span class="flap-cell">{p.deliveryDays}</span></span>
      <span aria-hidden="true">{p.deliveryDays === 1 ? 'giorno' : 'giorni'}</span>
    </p>
  </div>
</article>
