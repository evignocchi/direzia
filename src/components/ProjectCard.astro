---
import DemoSite from './DemoSite.astro';
import DemoBadge from './DemoBadge.astro';
import Icon from './Icon.astro';
import { copy } from '../data/copy';
import { projectCategoryLabel, type Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
---

<article class="group relative flex flex-col" data-category={p.category} data-project-card>
  <div class="relative">
    <DemoSite frame="browser" site={p.site} name={p.name} label={`Anteprima del sito di ${p.name}`} class="transition-transform duration-300 group-hover:-translate-y-1 motion-reduce:transition-none motion-reduce:group-hover:translate-y-0" />
    {p.demo && <DemoBadge class="absolute right-2 top-1.5" />}
  </div>
  <div class="mt-4 flex flex-1 flex-col">
    <p class="text-sm font-bold text-terracotta">{projectCategoryLabel(p.category)}</p>
    <h3 class="mt-1 text-xl text-abete-scuro">
      <a href={`/progetti/${p.slug}`} class="no-underline after:absolute after:inset-0 after:content-[''] hover:underline">{p.name}</a>
    </h3>
    <p class="mt-2 text-muschio">{p.result}</p>
    <p class="mt-auto flex items-center justify-between pt-4 text-sm font-bold text-abete">
      <span>Online in {copy.showcase.daysLabel(p.deliveryDays)}</span>
      <span class="inline-flex items-center gap-1">{copy.showcase.cardCta}<Icon name="arrow" size={16} /></span>
    </p>
  </div>
</article>
